# Supabase (public read-only for web)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Revalidate (call from CI/webhook; use header x-revalidate-secret)
REVALIDATION_SECRET=your-secret

# Resend (send-email API)
RESEND_API_KEY=re_xxxx
# Required: shared secret for /api/send-email (Bearer or x-send-email-secret).
# Must match Supabase edge secret SEND_EMAIL_SECRET used by send-order-email.
SEND_EMAIL_SECRET=generate-a-long-random-secret
# Optional: custom from address after verifying domain in Resend
# SEND_EMAIL_FROM=StoreLink <noreply@storelink.ng>
# Optional: inbox for /api/support/contact
# SUPPORT_CONTACT_TO=support@storelink.app

# Cloudflare Turnstile (required in prod for /api/support/contact)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# App store links (insert when live; optional until then)
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/...
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...

# Admin dashboard (redirect /admin to this URL)
# NEXT_PUBLIC_ADMIN_APP_URL=https://admin.storelink.ng

# Classic storefront (`/sell`) was spun out to Sellfolio. Middleware 308s /sell → /app.
# Do not set STOREFRONT_ORIGIN on this project anymore.

# Server-only Geocoding key for POST /api/geocode (signed-in + rate-limited).
# Restrict in Google Cloud: Geocoding API only; HTTP referrer / IP = your web host.
# GOOGLE_MAPS_API_KEY=
# Optional client embed key (marketing Maps JS only — not used by /api/geocode)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Paystack — Nigeria primary; add regional keys when expanding checkout.
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
